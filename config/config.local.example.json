{
  "relatedCandidateUrls": {
    "https://example.com": ["https://example.com/account/check-in"]
  },
  "logicalCheckinGroups": {
    "https://example.com": "example-service"
  },
  "additionalBookmarkSources": [
    {
      "name": "Chrome",
      "path": "C:\\Path\\To\\Chrome\\Profile\\Bookmarks",
      "mobileFolderNames": ["Automation"],
      "targetFolderNames": ["Daily"],
      "optional": true
    }
  ],
  "configuredTargets": [
    {
      "title": "Configured check-in example",
      "url": "https://configured.example.com/account/check-in",
      "folderName": "Daily"
    }
  ],
  "newApiCaptchaRules": {
    "https://captcha.example.com": {
      "checkinPath": "/api/user/checkin",
      "captchaPath": "/api/user/checkin/captcha",
      "userStorageKeys": ["user"],
      "maxAttempts": 3,
      "minConfidence": 30,
      "verificationAttempts": 3,
      "verificationDelayMs": 750
    }
  },
  "newApiSignInRules": {
    "https://signin.example.com": {
      "signInPath": "/api/user/sign_in",
      "selfPath": "/api/user/self",
      "statusPath": "/api/status",
      "logPath": "/api/log/self",
      "logSuccessText": "Daily reward",
      "rewardAmount": 1,
      "logType": 1,
      "userStorageKeys": ["user"],
      "verificationAttempts": 3,
      "verificationDelayMs": 750
    }
  },
  "visitCheckinRules": {
    "https://example.com": { "after": "08:00" }
  },
  "agentrouterAccounts": [
    {
      "origin": "https://example.com",
      "accountKey": "github",
      "provider": "GitHub",
      "automationUserDataDir": "data/edge-agentrouter-github",
      "statePath": "data/agentrouter-github-state.json"
    },
    {
      "origin": "https://example.com",
      "accountKey": "linuxdo",
      "provider": "LinuxDO",
      "automationUserDataDir": "data/edge-agentrouter-linuxdo",
      "statePath": "data/agentrouter-linuxdo-state.json"
    }
  ],
  "reauthCheckinRules": {
    "https://example.com": {
      "pageUrl": "https://example.com/console",
      "loginUrl": "https://example.com/login",
      "after": "08:00",
      "provider": "LinuxDO",
      "accountMenuSelector": "button[aria-haspopup=\"true\"]",
      "logoutTexts": ["退出登录", "退出"],
      "quotaEndpoint": "https://example.com/api/user/self",
      "quotaField": "data.quota",
      "quotaDomEvidence": {
        "labelText": "当前余额",
        "valueSiblingIndex": 1
      },
      "loginSuccessStorageEvidence": {
        "storage": "localStorage",
        "key": "user",
        "field": "checked_in",
        "expected": true
      }
    }
  },
  "preCheckinDismissRules": {
    "https://example.com": {
      "buttonTexts": ["关闭公告"],
      "selectors": ["button[aria-label=\"Close\"]"],
      "waitMs": 3000,
      "maxDismissals": 3
    }
  },
  "autoAcceptUpdatedTermsOrigins": [
    "https://example.com"
  ],
  "autoClickTurnstileOrigins": [
    "https://example.com"
  ],
  "savedLoginFormRules": {
    "https://example.com": {
      "expanderTexts": ["Use email or username"],
      "afterClickWaitMs": 500
    }
  },
  "savedLoginSessionRules": {
    "https://example.com": {
      "type": "new_api",
      "selfPath": "/api/user/self",
      "userStorageKeys": ["user"]
    }
  },
  "challengeInteractionRules": {
    "https://example.com": {
      "type": "click",
      "phase": "before",
      "waitMs": 30000,
      "settleMs": 3000,
      "retryAction": false,
      "retryActionWaitMs": 5000
    }
  },
  "checkinCaptchaDialogRules": {
    "https://example.com": {
      "dialogSelector": ".checkin-modal",
      "imageSelector": "img.captcha",
      "inputSelector": "input[placeholder=\"请输入验证码\"]",
      "confirmTexts": ["确认"],
      "refreshTexts": ["刷新验证码"],
      "minLength": 4,
      "maxLength": 8,
      "minImageWidth": 40,
      "minImageHeight": 20,
      "minConfidence": 30,
      "waitMs": 5000,
      "maxAttempts": 3
    }
  },
  "sequentialActionRules": {
    "https://example.com": {
      "steps": [
        {
          "url": "https://example.com/account/check-in",
          "actionTexts": ["Check in"],
          "completedTexts": ["Checked in today"],
          "successTexts": ["Check-in successful"],
          "disabledActionIsComplete": true,
          "reloadOnUnconfirmed": true,
          "waitMs": 10000
        },
        {
          "url": "https://example.com/account/reward-draw",
          "actionTexts": ["Draw x10"],
          "completedTexts": ["Today's draw is complete"],
          "successTexts": ["Draw successful"],
          "successIncludes": ["Draw result"],
          "acceptGenericCheckinState": false,
          "responseEvidence": [
            {
              "urlIncludes": "/draw",
              "methods": ["POST"],
              "successAny": [
                { "path": "success", "equals": true },
                { "path": "code", "equals": 0 }
              ]
            }
          ],
          "waitMs": 10000
        }
      ]
    }
  },
  "nativeWafPreflightUrls": [
    { "url": "https://example.com/account/check-in", "waitSeconds": 45, "passiveOnly": true }
  ],
  "nativeChallengePreflight": [
    {
      "url": "https://example.com/account/check-in",
      "waitSeconds": 30,
      "action": {
        "actionTexts": ["Check in"],
        "dismissButtonTexts": ["Close"],
        "dismissSelectors": ["button[aria-label=\"Close\"]"],
        "dismissWaitMs": 3000,
        "maxDismissals": 3
      }
    }
  ],
  "calendarDayCheckinOrigins": [
    "https://example.com"
  ],
  "calendarDayCheckinPaths": {
    "https://example.com": ["/account/check-in"]
  }
}
