{
  "name": "codex-bookmark-checkin",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "health": "node src/health-cli.mjs",
    "preflight": "node src/preflight.mjs",
    "dry-run": "node src/index.mjs --dry-run",
    "status": "node src/status-dashboard.mjs",
    "status:final": "node src/checkin-final-state.mjs",
    "unknown:summary": "node src/unknown-summary.mjs",
    "contract:generate": "node scripts/generate-checkin-contract.mjs",
    "contract:check": "node scripts/generate-checkin-contract.mjs --check",
    "release": "node src/code-release.mjs",
    "modules:check": "node src/module-reachability.mjs",
    "modules:report": "node src/module-reachability.mjs --json",
    "integrity:check": "node src/runtime-integrity.mjs",
    "integrity:record": "node src/runtime-integrity.mjs --record",
    "start": "node src/index.mjs"
  },
  "dependencies": {
    "playwright-core": "1.61.1",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0"
  }
}
